# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit secrets.toml to version control.
# secrets.toml is listed in .gitignore.

# ── Gemini API ────────────────────────────────────────────────────────────────
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY = "your-gemini-api-key-here"

# ── Gemini Model ──────────────────────────────────────────────────────────────
# Recommended: "gemini-2.5-flash-preview-05-20" or "gemini-2.0-flash"
# Leave blank to use the application default (defined in utils/config.py).
# Full model list: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL = "gemini-2.5-flash-preview-05-20"
